[sub_resource type="Resource" id="Resource_r1_stance"]
script = ExtResource("5_status")
status_id = &"status_bayda_hit_me_more"
display_name = "Бейте ещё"
description = "Каждый повредивший Байду вражеский ход восстанавливает 3 выносливости, а при 4 HP или меньше — 4. Распахнутая защита может набрать до 3 стаков."
polarity = 1
tags = Array[StringName]([&"buff", &"reaction", &"stamina_reaction", &"reckless"])
duration_turns = 2
reactions = Array[ExtResource("6_reaction")]([SubResource("Resource_r1_reaction_normal"), SubResource("Resource_r1_reaction_low")])

[sub_resource type="Resource" id="Resource_r1_apply_stance"]
script = ExtResource("4_apply_status")
status_definition = SubResource("Resource_r1_stance")
effect_id = &"effect_bayda_hit_me_more_stance"


