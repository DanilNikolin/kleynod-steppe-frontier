[resource]
script = ExtResource("1_ability")
ability_id = &"ability_bayda_hit_me_more"
display_name = "Бейте ещё"
description = "Байда превращает вражескую агрессию в топливо. До следующего хода каждое отдельное вражеское действие, повредившее его здоровью или обороне, восстанавливает выносливость и накладывает Распахнутую защиту."
branch = 3
growth_table = SubResource("Resource_growth_table")
stamina_cost = 0
cooldown_turns = 3
targeting = SubResource("Resource_targeting")
effects = Array[ExtResource("3_effect")]([SubResource("Resource_base_apply_stance")])
