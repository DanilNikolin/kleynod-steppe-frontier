effect_id = &"effect_bayda_hit_me_more_exposure"


[sub_resource type="Resource" id="Resource_rank2_armor_modifier"]
script = ExtResource("8_modifier")
amount_per_stack = -1

[sub_resource type="Resource" id="Resource_rank2_exposure"]
script = ExtResource("5_status")
status_id = &"status_bayda_hit_me_more_exposure"
display_name = "Распахнутая защита"
description = "Каждый стак снижает броню на 1. Максимум 2 стака."
polarity = 2
tags = Array[StringName]([&"debuff", &"armor_debuff", &"self_exposure", &"reckless"])
duration_turns = 1
max_stacks = 2
reapply_rule = 1
