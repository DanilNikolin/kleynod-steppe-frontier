[gd_resource type="Resource" script_class="CampaignLocalLocationDefinition" load_steps=10 format=3]

[ext_resource type="Script" path="res://core/campaign/world/local/campaign_local_location_definition.gd" id="1_location"]
[ext_resource type="Script" path="res://core/campaign/world/local/campaign_local_interaction_definition.gd" id="2_interaction"]

[sub_resource type="Resource" id="CentralCamp"]
script = ExtResource("2_interaction")
interaction_id = &"home_zone_central_camp"
display_name = "Центральное место"
description = "Пока здесь только пустая земля. Именно отсюда начнётся будущий HOME."
local_position = Vector2(1882, 756)
action_labels = PackedStringArray("Осмотреть место")

[sub_resource type="Resource" id="PartyShelter"]
script = ExtResource("2_interaction")
interaction_id = &"home_zone_party_shelter"
display_name = "Место отряда"
description = "Пустое место рядом с будущим центром лагеря."
local_position = Vector2(2650, 756)
action_labels = PackedStringArray("Осмотреть место")

[sub_resource type="Resource" id="CommonShelter"]
script = ExtResource("2_interaction")
interaction_id = &"home_zone_common_shelter"
display_name = "Общее место лагеря"
description = "Здесь пока ничего нет. Позже можно будет организовать общий походный навес."
local_position = Vector2(3418, 756)
action_labels = PackedStringArray("Осмотреть место")

[sub_resource type="Resource" id="ResidentBlacksmith"]
script = ExtResource("2_interaction")
interaction_id = &"debug_home_blacksmith"
display_name = "Остап Коваль"
description = "Приглашённый коваль родного поселения."
local_position = Vector2(4224, 648)
action_labels = PackedStringArray("Поговорить", "ОТКРЫТЬ КУЗНИЦУ")

[sub_resource type="Resource" id="Carpenter"]
script = ExtResource("2_interaction")
interaction_id = &"debug_home_carpenter"
display_name = "Плотник"
action_labels = PackedStringArray("Поговорить")
description = "Бродячий мастер: берётся за крыши и стропила, а за словом в карман не лезет."
local_position = Vector2(3744, 389)

[sub_resource type="Resource" id="CarpenterWorksite"]
script = ExtResource("2_interaction")
interaction_id = &"debug_home_carpenter_worksite"
display_name = "Временное рабочее место плотника"
description = "Под навесом рядом стоят верстак, козлы, пила и топор; на досках разложен инструмент. Плотник подготовил этот угол сам, чтобы не работать на коленке. Это ещё не мастерская и не дом."
local_position = Vector2(4013, 907)
action_labels = PackedStringArray("ОТКРЫТЬ СТРОИТЕЛЬСТВО")
required_home_resident_id = &"debug_carpenter"

[sub_resource type="Resource" id="ForgeSite"]
script = ExtResource("2_interaction")
interaction_id = &"home_forge_site"
display_name = "Место будущей кузницы"
description = "Здесь плотник поставит здание кузницы. Контракт оформляется на его временном рабочем месте."
local_position = Vector2(4762, 756)
action_labels = PackedStringArray("Осмотреть", "ОТКРЫТЬ КУЗНИЦУ")

[resource]
script = ExtResource("1_location")
local_location_id = &"debug_home_local"
display_name = "Родное место"
description = "Пока это почти пустой участок степи у реки. Здесь ещё только предстоит построить настоящий дом."
reference_size = Vector2(5760, 1080)
view_width = 1920.0
visual_scene_path = "res://scenes/campaign/local_location/home_visual_stage.tscn"
interactions = Array[ExtResource("2_interaction")]([SubResource("CarpenterWorksite"), SubResource("ForgeSite"), SubResource("Carpenter"), SubResource("CentralCamp"), SubResource("PartyShelter"), SubResource("CommonShelter"), SubResource("ResidentBlacksmith")])