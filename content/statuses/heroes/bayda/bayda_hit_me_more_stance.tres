[sub_resource type="Resource" id="Resource_restore_stamina"]
script = ExtResource("4_restore")
stamina_amount = 3
effect_id = &"effect_bayda_hit_me_more_restore_stamina"
recipient = 1

[sub_resource type="Resource" id="Resource_apply_exposure"]
script = ExtResource("5_apply_status")
status_definition = ExtResource("6_exposure")
effect_id = &"effect_bayda_hit_me_more_exposure"
recipient = 1

[sub_resource type="Resource" id="Resource_reaction"]
script = ExtResource("2_reaction")
effects = Array[ExtResource("3_effect")]([SubResource("Resource_restore_stamina"), SubResource("Resource_apply_exposure")])

[resource]
script = ExtResource("1_status")
status_id = &"status_bayda_hit_me_more"
display_name = "Бейте ещё"
description = "До следующего хода каждое отдельное вражеское действие, повредившее Байде здоровье или оборону, восстанавливает 3 выносливости и накладывает 1 стак Распахнутой защиты. Каждый стак снижает броню на 1, максимум 3 стака."
polarity = 1
tags = Array[StringName]([&"buff", &"reaction", &"stamina_reaction", &"reckless"])
duration_turns = 2
reactions = Array[ExtResource("2_reaction")]([SubResource("Resource_reaction")])
