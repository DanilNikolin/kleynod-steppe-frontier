; ============================================================
; ABILITY
; ============================================================

[resource]
script = ExtResource("1_ability")
ability_id = &"ability_bayda_last_word"
display_name = "Последнее слово"
description = "Байда наносит 7 урона с пробитием 1 и бросает вызов врагам. Первый враг, который до следующего хода повредит его здоровью или обороне, получает контратаку на 6 урона с пробитием 1."
branch = 3
growth_table = SubResource("Resource_growth_table")
stamina_cost = 8
initial_lock_turns = 2
cooldown_turns = 4
targeting = SubResource("Resource_targeting")
effects = Array[ExtResource("3_effect")]([SubResource("Resource_r0_apply_stance"), SubResource("Resource_r0_damage")])