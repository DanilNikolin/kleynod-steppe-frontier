[resource]
script = ExtResource("1_ability")
ability_id = &"ability_bayda_black_massacre"
display_name = "Чёрная расправа"
description = "Байда обрушивается на выбранного врага и противника за ним, ломая их защиту и сковывая строй."
branch = 1
growth_table = SubResource("Resource_growth_table")
stamina_cost = 10
initial_lock_turns = 2
cooldown_turns = 4
targeting = SubResource("Resource_targeting")
effects = Array[ExtResource("3_effect")]([SubResource("Resource_damage"), SubResource("Resource_armor"), SubResource("Resource_pinned")])