[sub_resource type="Resource" id="OldLoggingSite"]
script = ExtResource("2_site")
site_id = &"starter_materials_cache"
display_name = "Старая вырубка"
description = "На краю рощи остались пригодные доски, жерди, крепёж и другой материал. Для настоящего строительства этого мало, но для первого лагеря хватит."
map_position = Vector2(450, 240)
starting_available = true
site_type = 0
exploration_enabled = true
exploration_action_label = "ИССЛЕДОВАТЬ ВЫРУБКУ"
material_reward = 8

[resource]
script = ExtResource("1_area")
area_id = &"debug_home_outskirts_materials_area"
display_name = "Ближняя роща"
description = "Небольшая роща недалеко от будущего поселения. Пока здесь есть только одна полезная точка."
sites = Array[ExtResource("2_site")]([SubResource("OldLoggingSite")])