[gd_resource type="Resource" script_class="CampaignDialogueDefinition" format=3]

[ext_resource type="Script" path="res://core/campaign/dialogue/campaign_dialogue_definition.gd" id="dialogue"]
[ext_resource type="Script" path="res://core/campaign/dialogue/campaign_dialogue_node.gd" id="node"]
[ext_resource type="Script" path="res://core/campaign/dialogue/campaign_dialogue_choice.gd" id="choice"]
[ext_resource type="Script" path="res://core/campaign/dialogue/campaign_dialogue_condition.gd" id="condition"]

[sub_resource type="Resource" id="condition_not_started"]
script = ExtResource("condition")
kind = 0
target_id = &"village_board_abandoned_cart"

[sub_resource type="Resource" id="condition_active"]
script = ExtResource("condition")
kind = 1
target_id = &"village_board_abandoned_cart"

[sub_resource type="Resource" id="condition_ready"]
script = ExtResource("condition")
kind = 2
target_id = &"village_board_abandoned_cart"

[sub_resource type="Resource" id="condition_completed"]
script = ExtResource("condition")
kind = 3
target_id = &"village_board_abandoned_cart"

[sub_resource type="Resource" id="choice_leave"]
script = ExtResource("choice")
choice_id = &"leave"
text = "Отойти от доски."
next_node_id = &""

[sub_resource type="Resource" id="choice_read_notice"]
script = ExtResource("choice")
choice_id = &"read_notice"
text = "Прочитать: «Разграбленный воз»."
next_node_id = &"details"

[sub_resource type="Resource" id="choice_accept"]
script = ExtResource("choice")
choice_id = &"accept"
text = "Взяться за дело."
next_node_id = &"accepted"
conditions = Array[ExtResource("condition")]([SubResource("condition_not_started")])
action = 1
target_id = &"village_board_abandoned_cart"

[sub_resource type="Resource" id="choice_back_offer"]
script = ExtResource("choice")
choice_id = &"back_offer"
text = "Посмотреть остальные объявления."
next_node_id = &"offer"

[sub_resource type="Resource" id="choice_read_active"]
script = ExtResource("choice")
choice_id = &"read_active"
text = "Перечитать объявление."
next_node_id = &"active_details"

[sub_resource type="Resource" id="choice_back_active"]
script = ExtResource("choice")
choice_id = &"back_active"
text = "Вернуться к доске."
next_node_id = &"active"

[sub_resource type="Resource" id="choice_turn_in"]
script = ExtResource("choice")
choice_id = &"turn_in"
text = "Снять объявление и отметить работу выполненной."
next_node_id = &"closed"
conditions = Array[ExtResource("condition")]([SubResource("condition_ready")])
action = 2
target_id = &"village_board_abandoned_cart"

[sub_resource type="Resource" id="node_ready"]
script = ExtResource("node")
node_id = &"ready"
text = "Объявление о разграбленном возе всё ещё висит на доске. Налётчики уничтожены — работу можно отметить выполненной."
conditions = Array[ExtResource("condition")]([SubResource("condition_ready")])
choices = Array[ExtResource("choice")]([SubResource("choice_turn_in"), SubResource("choice_leave")])

[sub_resource type="Resource" id="node_completed"]
script = ExtResource("node")
node_id = &"completed"
text = "На месте объявления о разграбленном возе остался только след от кнопки. Просьба жителей выполнена."
conditions = Array[ExtResource("condition")]([SubResource("condition_completed")])

[sub_resource type="Resource" id="node_active"]
script = ExtResource("node")
node_id = &"active"
text = "На доске висит несколько старых записок. Объявление о разграбленном возе отмечено — за него уже взялись."
conditions = Array[ExtResource("condition")]([SubResource("condition_active")])
choices = Array[ExtResource("choice")]([SubResource("choice_read_active"), SubResource("choice_leave")])

[sub_resource type="Resource" id="node_offer"]
script = ExtResource("node")
node_id = &"offer"
text = "На доске висят просьбы жителей, старые объявления и дорожные слухи. Среди них выделяется свежий листок: «Разграбленный воз»."
conditions = Array[ExtResource("condition")]([SubResource("condition_not_started")])
choices = Array[ExtResource("choice")]([SubResource("choice_read_notice"), SubResource("choice_leave")])

[sub_resource type="Resource" id="node_fallback"]
script = ExtResource("node")
node_id = &"fallback"
text = "Среди объявлений сейчас нет ничего, что требовало бы твоего внимания."
choices = Array[ExtResource("choice")]([SubResource("choice_leave")])

[sub_resource type="Resource" id="node_details"]
script = ExtResource("node")
node_id = &"details"
text = "«У старой рощи нашли разграбленный торговый воз. Налётчики всё ещё держатся рядом и нападают на тех, кто идёт лесной дорогой. Кто сможет очистить место — пусть отметит объявление после возвращения.»"
choices = Array[ExtResource("choice")]([SubResource("choice_accept"), SubResource("choice_back_offer"), SubResource("choice_leave")])

[sub_resource type="Resource" id="node_accepted"]
script = ExtResource("node")
node_id = &"accepted"
text = "Ты отмечаешь объявление. Место у разграбленного воза добавлено к известным точкам в лесу."
choices = Array[ExtResource("choice")]([SubResource("choice_leave")])

[sub_resource type="Resource" id="node_active_details"]
script = ExtResource("node")
node_id = &"active_details"
text = "Разграбленный воз находится у старой рощи. Чтобы выполнить просьбу, нужно уничтожить оставшихся там налётчиков."
choices = Array[ExtResource("choice")]([SubResource("choice_back_active"), SubResource("choice_leave")])

[sub_resource type="Resource" id="node_closed"]
script = ExtResource("node")
node_id = &"closed"
text = "Ты снимаешь объявление с доски и оставляешь отметку о выполненной работе. Жители запомнят помощь."

[resource]
script = ExtResource("dialogue")
dialogue_id = &"village_notice_board"
speaker_name = "Доска объявлений"
entry_node_ids = Array[StringName]([&"ready", &"completed", &"active", &"offer", &"fallback"])
nodes = Array[ExtResource("node")]([SubResource("node_ready"), SubResource("node_completed"), SubResource("node_active"), SubResource("node_offer"), SubResource("node_fallback"), SubResource("node_details"), SubResource("node_accepted"), SubResource("node_active_details"), SubResource("node_closed")])