[resource]
script = ExtResource("1_hero")
hero_id = &"hero_bayda"
display_name = "Байда-характерник"
description = "Первый настоящий герой. Core Module реализован, способности и Skill Grid пока используют временный debug-контент."
base_combatant_definition = ExtResource("3_combatant")
core_module = ExtResource("4_core")
skill_grid = ExtResource("5_grid")
personal_abilities = Array[ExtResource("2_ability")]([ExtResource("6_sabre"), ExtResource("8_blood_payment"), ExtResource("9_gallows_hook"), ExtResource("10_grit_teeth"), ExtResource("11_slanting_cut"), ExtResource("12_pin_down"), ExtResource("13_black_massacre"), ExtResource("14_open_vein"), ExtResource("15_palisade"), ExtResource("16_without_looking_back"), ExtResource("17_do_not_bend"), ExtResource("18_answer_for_answer"), ExtResource("19_hit_me_more"), ExtResource("20_last_word"), ExtResource("7_mend")])
starting_known_ability_ids = Array[StringName]([&"ability_sabre_slash", &"ability_bayda_blood_payment", &"ability_bayda_gallows_hook", &"ability_bayda_grit_teeth"])
default_ability_id = &"ability_sabre_slash"
starting_active_slot_count = 4
maximum_active_slot_count = 6
