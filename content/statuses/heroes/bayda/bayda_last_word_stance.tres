[gd_resource type="Resource" script_class="BattleStatusDefinition" format=3]

[ext_resource type="Script" path="res://core/battle/statuses/battle_status_definition.gd" id="1_status"]
[ext_resource type="Script" path="res://core/battle/statuses/battle_status_reaction_definition.gd" id="2_reaction"]
[ext_resource type="Script" path="res://core/battle/effects/battle_effect.gd" id="3_effect"]
[ext_resource type="Script" path="res://core/battle/effects/damage_effect.gd" id="4_damage"]

[sub_resource type="Resource" id="Resource_counter_damage"]
script = ExtResource("4_damage")
base_damage = 6
strength_scaling = 0.0
armor_piercing = 1
crit_mode = 0
effect_id = &"effect_bayda_last_word_counter"

[sub_resource type="Resource" id="Resource_reaction"]
script = ExtResource("2_reaction")
damage_requirement = 1
effects = Array[ExtResource("3_effect")]([SubResource("Resource_counter_damage")])
consume_status_on_trigger = true

[resource]
script = ExtResource("1_status")
status_id = &"status_bayda_last_word"
display_name = "Последнее слово"
description = "Первый враг, который до следующего хода Байды повредит его здоровью или обороне, получает мощную контратаку."
polarity = 1
tags = Array[StringName]([&"buff", &"reaction", &"counterattack", &"gold"])
duration_turns = 2
reactions = Array[ExtResource("2_reaction")]([SubResource("Resource_reaction")])