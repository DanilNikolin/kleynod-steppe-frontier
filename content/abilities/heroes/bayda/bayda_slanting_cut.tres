[resource]
script = ExtResource("1_ability")
ability_id = &"ability_bayda_slanting_cut"
display_name = "Косая сечь"
description = "Байда косым рубящим ударом прорезает врагов, стоящих друг за другом в одном ряду, раскалывая их броню."
branch = 1
growth_table = SubResource("Resource_growth_table")
stamina_cost = 6
targeting = SubResource("Resource_targeting")
effects = Array[ExtResource("3_effect")]([SubResource("Resource_damage"), SubResource("Resource_cracked_armor")])