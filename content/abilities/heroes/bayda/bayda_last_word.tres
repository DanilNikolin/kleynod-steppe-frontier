[gd_resource type="Resource" script_class="AbilityDefinition" format=3]

[ext_resource type="Script" path="res://core/battle/abilities/ability_definition.gd" id="1_ability"]
[ext_resource type="Script" path="res://core/battle/targeting/ability_targeting_definition.gd" id="2_targeting"]
[ext_resource type="Script" path="res://core/battle/effects/battle_effect.gd" id="3_effect"]
[ext_resource type="Script" path="res://core/battle/effects/damage_effect.gd" id="4_damage"]
[ext_resource type="Script" path="res://core/battle/effects/apply_status_effect.gd" id="5_apply_status"]
[ext_resource type="Resource" path="res://content/statuses/heroes/bayda/bayda_last_word_stance.tres" id="6_status"]

[sub_resource type="Resource" id="Resource_apply_stance"]
script = ExtResource("5_apply_status")
status_definition = ExtResource("6_status")
recipient = 1
effect_id = &"effect_bayda_last_word_stance"

[sub_resource type="Resource" id="Resource_damage"]
script = ExtResource("4_damage")
base_damage = 7
strength_scaling = 0.0
armor_piercing = 1
crit_mode = 0
effect_id = &"effect_bayda_last_word_damage"

[sub_resource type="Resource" id="Resource_targeting"]
script = ExtResource("2_targeting")
aim_requirement = 1
aim_relation_mask = 4
aim_offsets = Array[Vector2i]([Vector2i(1, -1), Vector2i(2, -1), Vector2i(3, -1), Vector2i(1, 0), Vector2i(2, 0), Vector2i(3, 0), Vector2i(1, 1), Vector2i(2, 1), Vector2i(3, 1)])
affected_relation_mask = 4
impact_offsets = Array[Vector2i]([Vector2i(0, 0)])

[resource]
script = ExtResource("1_ability")
ability_id = &"ability_bayda_last_word"
display_name = "Последнее слово"
description = "Байда наносит 7 урона с пробитием 1 и бросает вызов врагам. Первый враг, который до следующего хода повредит его здоровью или обороне, получает контратаку на 6 урона с пробитием 1."
branch = 3
stamina_cost = 8
initial_lock_turns = 2
cooldown_turns = 4
targeting = SubResource("Resource_targeting")
effects = Array[ExtResource("3_effect")]([SubResource("Resource_apply_stance"), SubResource("Resource_damage")])