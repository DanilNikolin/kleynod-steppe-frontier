[gd_resource type="Resource" script_class="BattleStatusDefinition" format=3]

[ext_resource type="Script" path="res://core/battle/statuses/battle_status_definition.gd" id="1_status"]
[ext_resource type="Script" path="res://core/battle/statuses/battle_status_reaction_definition.gd" id="2_reaction"]
[ext_resource type="Script" path="res://core/battle/effects/battle_effect.gd" id="3_effect"]
[ext_resource type="Script" path="res://core/battle/effects/restore_stamina_effect.gd" id="4_restore"]
[ext_resource type="Script" path="res://core/battle/effects/apply_status_effect.gd" id="5_apply_status"]
[ext_resource type="Resource" path="res://content/statuses/heroes/bayda/bayda_hit_me_more_exposure.tres" id="6_exposure"]

[sub_resource type="Resource" id="Resource_restore_stamina"]
script = ExtResource("4_restore")
stamina_amount = 2
recipient = 1
effect_id = &"effect_bayda_hit_me_more_restore_stamina"

[sub_resource type="Resource" id="Resource_apply_exposure"]
script = ExtResource("5_apply_status")
status_definition = ExtResource("6_exposure")
recipient = 1
effect_id = &"effect_bayda_hit_me_more_exposure"

[sub_resource type="Resource" id="Resource_reaction"]
script = ExtResource("2_reaction")
damage_requirement = 1
effects = Array[ExtResource("3_effect")]([SubResource("Resource_restore_stamina"), SubResource("Resource_apply_exposure")])

[resource]
script = ExtResource("1_status")
status_id = &"status_bayda_hit_me_more"
display_name = "Бейте ещё"
description = "До следующего хода каждое отдельное вражеское действие, повредившее Байде здоровье или оборону, восстанавливает 2 выносливости, но снижает его броню на 1."
polarity = 1
tags = Array[StringName]([&"buff", &"reaction", &"stamina_reaction", &"reckless"])
duration_turns = 2
reactions = Array[ExtResource("2_reaction")]([SubResource("Resource_reaction")])