[gd_resource type="Resource" script_class="BattleStatusDefinition" format=3]

[ext_resource type="Script" path="res://core/battle/statuses/battle_status_definition.gd" id="1_status"]
[ext_resource type="Script" path="res://core/battle/effects/battle_effect.gd" id="2_effect"]
[ext_resource type="Script" path="res://core/battle/statuses/battle_status_periodic_trigger.gd" id="3_trigger"]
[ext_resource type="Script" path="res://core/battle/effects/damage_effect.gd" id="4_damage"]

[sub_resource type="Resource" id="Resource_bleeding_damage"]
script = ExtResource("4_damage")
base_damage = 2
armor_piercing = 999
minimum_damage = 2
effect_id = &"effect_bayda_bleeding_tick"

[sub_resource type="Resource" id="Resource_end_trigger"]
script = ExtResource("3_trigger")
effects = Array[ExtResource("2_effect")]([SubResource("Resource_bleeding_damage")])

[resource]
script = ExtResource("1_status")
status_id = &"status_bayda_bleeding"
display_name = "Кровотечение"
description = "Теряет 2 здоровья в конце каждого своего хода."
polarity = 2
tags = Array[StringName]([&"debuff", &"damage_over_time", &"bleeding"])
duration_turns = 2
periodic_triggers = Array[ExtResource("3_trigger")]([SubResource("Resource_end_trigger")])