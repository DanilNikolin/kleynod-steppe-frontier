[resource]
script = ExtResource("1_campaign")
campaign_id = &"debug_campaign"
display_name = "Клейнод — Campaign Sandbox"
starting_heroes = Array[ExtResource("2_hero_state")]([SubResource("HeroBayda"), SubResource("HeroPlastunka"), SubResource("HeroMarkswoman"), SubResource("HeroMavka"), SubResource("HeroChugaister"), SubResource("HeroHunter"), SubResource("HeroWolf"), SubResource("HeroSchemonk")])
starting_selected_hero_id = &"hero_bayda"
starting_party_member_hero_ids = Array[StringName]([&"hero_bayda", &"hero_plastunka", &"hero_powder_markswoman"])
starting_gold = 0
loot_catalog = Array[ExtResource("20_item_definition_script")]([ExtResource("21_loot_sabre"), ExtResource("22_loot_armor"), ExtResource("23_loot_charm"), ExtResource("24_loot_berdysh")])
locations = Array[ExtResource("4_location_script")]([ExtResource("5_location")])
world_map_definition = ExtResource("6_world_map")
starting_day = 0
days_per_season = 20
starting_reputation = 0
starting_materials = 0
