[sub_resource type="Resource" id="Resource_armor_modifier"]
script = ExtResource("3_modifier")
stat = 0
amount_per_stack = -2

[resource]
script = ExtResource("1_status")
status_id = &"status_bayda_gallows_hooked"
display_name = "На крюке"
description = "Цель не может двигаться до конца двух своих следующих ходов и теряет 2 брони."
polarity = 2
tags = Array[StringName]([&"debuff", &"control", &"movement_control", &"immobilized", &"hook", &"armor_debuff"])
duration_turns = 2
action_restriction = SubResource("Resource_gallows_hook_restriction")
stat_modifiers = Array[ExtResource("3_modifier")]([SubResource("Resource_armor_modifier")])