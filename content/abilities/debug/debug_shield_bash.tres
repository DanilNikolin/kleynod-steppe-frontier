[resource]
script = ExtResource("1_ability")
ability_id = &"ability_shield_bash"
display_name = "Удар щитом"
description = "Наносит небольшой урон и отталкивает цель на две клетки. Толчок останавливается перед препятствием, границей поля или другим бойцом."
stamina_cost = 4
targeting = SubResource("Resource_shield_targeting")
effects = Array[ExtResource("3_effect")]([SubResource("Resource_shield_damage"), SubResource("Resource_shield_push")])
