[resource]
script = ExtResource("1_ability")
ability_id = &"ability_bayda_answer_for_answer"
display_name = "Ответ за ответ"
description = "Байда принимает размен: каждое повредившее его вражеское действие вызывает контратаку, а с ростом мастерства повторные ответы разрушают защиту нападающего."
branch = 3
growth_table = SubResource("Resource_growth_table")
