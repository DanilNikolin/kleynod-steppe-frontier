[gd_resource type="Resource" script_class="BattleEncounterDefinition" load_steps=12 format=3]

[ext_resource type="Script" path="res://core/battle/encounters/battle_encounter_definition.gd" id="1_encounter"]
[ext_resource type="Script" path="res://core/battle/encounters/combatant_spawn_definition.gd" id="2_spawn"]
[ext_resource type="Resource" path="res://content/combatants/debug/debug_sechevik.tres" id="3_player"]
[ext_resource type="Resource" path="res://content/combatants/debug/debug_steppe_raider.tres" id="4_enemy"]
[ext_resource type="Resource" path="res://content/loadouts/debug/debug_sweeping_sechevik_loadout.tres" id="5_player_loadout"]
[ext_resource type="Script" path="res://core/battle/sides/battle_side_rules.gd" id="6_side_rules"]

[sub_resource type="Resource" id="Resource_side_rules"]
script = ExtResource("6_side_rules")
left_team_id = &"team_player"
right_team_id = &"team_enemy"
divider_column = 5

[sub_resource type="Resource" id="Resource_player"]
script = ExtResource("2_spawn")
instance_id = &"player_area_tester"
combatant_definition = ExtResource("3_player")
team_id = &"team_player"
loadout_override = ExtResource("5_player_loadout")
coordinate = Vector2i(3, 2)

[sub_resource type="Resource" id="Resource_enemy_top"]
script = ExtResource("2_spawn")
instance_id = &"enemy_area_top"
combatant_definition = ExtResource("4_enemy")
team_id = &"team_enemy"
coordinate = Vector2i(6, 1)

[sub_resource type="Resource" id="Resource_enemy_middle"]
script = ExtResource("2_spawn")
instance_id = &"enemy_area_middle"
combatant_definition = ExtResource("4_enemy")
team_id = &"team_enemy"
coordinate = Vector2i(6, 2)

[sub_resource type="Resource" id="Resource_enemy_bottom"]
script = ExtResource("2_spawn")
instance_id = &"enemy_area_bottom"
combatant_definition = ExtResource("4_enemy")
team_id = &"team_enemy"
coordinate = Vector2i(6, 3)

[resource]
script = ExtResource("1_encounter")
encounter_id = &"debug_area_attack"
display_name = "Проверка площадной атаки"
description = "Сечевик проверяет вертикальную площадную атаку против трёх врагов."
rows = 5
columns = 10
side_rules = SubResource("Resource_side_rules")
combatant_spawns = Array[ExtResource("2_spawn")]([SubResource("Resource_player"), SubResource("Resource_enemy_top"), SubResource("Resource_enemy_middle"), SubResource("Resource_enemy_bottom")])