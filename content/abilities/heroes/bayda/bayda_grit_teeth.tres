[resource]
script = ExtResource("1_ability")
ability_id = &"ability_bayda_grit_teeth"
display_name = "Стиснуть зубы"
description = "Байда подавляет Надлом, вновь готовится пережить смертельный удар и восстанавливает выносливость ценой постоянного уменьшения её максимального запаса."
branch = 3
growth_table = SubResource("Resource_growth_table")
stamina_cost = 0
cooldown_turns = 3
targeting = SubResource("Resource_grit_teeth_targeting")
effects = Array[ExtResource("3_effect")]([SubResource("Resource_grit_teeth_effect")])