[resource]
script = ExtResource("1_ability")
ability_id = &"ability_bayda_palisade_of_cuts"
display_name = "Частокол порезов"
description = "Байда обрушивает на одну цель длинную серию быстрых порезов, вызывая кровотечение и раскрывая собственную защиту."
branch = 2
growth_table = SubResource("Resource_growth_table")
stamina_cost = 7
cooldown_turns = 2
targeting = SubResource("Resource_targeting")
effects = Array[ExtResource("3_effect")]([SubResource("Resource_cut_1"), SubResource("Resource_cut_2"), SubResource("Resource_cut_3"), SubResource("Resource_bleeding"), SubResource("Resource_self_exposure")])
presentation_profile = SubResource("Resource_palisade_presentation")