[gd_resource type="Resource" script_class="CampaignLocationDefinition" format=3]

[ext_resource type="Script" path="res://core/campaign/locations/campaign_location_definition.gd" id="1_location"]
[ext_resource type="Resource" path="res://content/encounters/debug/debug_deep_forest_repeatable_encounter.tres" id="2_encounter"]
[ext_resource type="PackedScene" path="res://scenes/battle/environments/deep_forest_environment.tscn" id="3_environment"]

[resource]
script = ExtResource("1_location")
location_id = &"debug_deep_forest"
display_name = "Дремучий лес"
description = "Глухая лесная чаща, используемая как повторяемая боевая локация."
encounter_definition = ExtResource("2_encounter")
party_spawn_instance_ids = Array[StringName]([&"party_slot_1", &"party_slot_2", &"party_slot_3"])
battle_environment_scene = ExtResource("3_environment")
