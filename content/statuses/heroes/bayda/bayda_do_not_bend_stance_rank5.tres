[resource]
script = ExtResource("1_status")
status_id = &"status_bayda_do_not_bend"
display_name = "Не согнуться"
description = "До следующего хода каждое отдельное вражеское действие, повредившее Байду, возвращает 2 обороны, а при 4 HP или меньше — 4."
polarity = 1
tags = Array[StringName]([&"buff", &"reaction", &"guard"])
duration_turns = 2
reactions = Array[ExtResource("2_reaction")]([SubResource("Resource_reaction_normal"), SubResource("Resource_reaction_low")])
