[resource]
script = ExtResource("1_ability")
ability_id = &"ability_bayda_pin_down"
display_name = "Прибить к земле"
description = "Байда тяжёлым ударом пригвождает врага к земле и полностью срывает его следующий ход."
branch = 1
growth_table = SubResource("Resource_growth_table")
stamina_cost = 8
initial_lock_turns = 1
cooldown_turns = 3
targeting = SubResource("Resource_targeting")
effects = Array[ExtResource("3_effect")]([SubResource("Resource_damage"), SubResource("Resource_stun")])