[resource]
script = ExtResource("1_ability")
ability_id = &"ability_bayda_blood_payment"
display_name = "Кровью заплатить"
description = "Байда ранит врага и расплачивается собственной кровью, превращая здоровье в выносливость и боевой темп."
branch = 2
growth_table = SubResource("Resource_growth_table")
stamina_cost = 0
cooldown_turns = 1
targeting = SubResource("Resource_targeting")
effects = Array[ExtResource("3_effect")]([SubResource("Resource_damage"), SubResource("Resource_health_cost"), SubResource("Resource_stamina")])