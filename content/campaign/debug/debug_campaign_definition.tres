starting_inventory_items = Array[ExtResource("6_item_script")]([ExtResource("7_sabre"), ExtResource("8_armor"), ExtResource("9_charm"), ExtResource("10_berdysh")])
locations = Array[ExtResource("4_location_script")]([ExtResource("5_location")])
