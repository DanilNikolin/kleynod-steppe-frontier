[gd_resource type="Resource" script_class="AbilityDefinition" format=3]

[ext_resource type="Script" path="res://core/battle/abilities/ability_definition.gd" id="1_ability"]
[ext_resource type="Script" path="res://core/battle/targeting/ability_targeting_definition.gd" id="2_targeting"]
[ext_resource type="Script" path="res://core/battle/effects/battle_effect.gd" id="3_effect"]
[ext_resource type="Script" path="res://core/battle/effects/apply_status_effect.gd" id="4_apply_status"]
[ext_resource type="Resource" path="res://content/statuses/heroes/bayda/bayda_hit_me_more_stance.tres" id="5_status"]

[sub_resource type="Resource" id="Resource_apply_stance"]
script = ExtResource("4_apply_status")
status_definition = ExtResource("5_status")
effect_id = &"effect_bayda_hit_me_more_stance"

[sub_resource type="Resource" id="Resource_targeting"]
script = ExtResource("2_targeting")
aim_requirement = 1
aim_relation_mask = 1
aim_offsets = Array[Vector2i]([Vector2i(0, 0)])
affected_relation_mask = 1
impact_offsets = Array[Vector2i]([Vector2i(0, 0)])

[resource]
script = ExtResource("1_ability")
ability_id = &"ability_bayda_hit_me_more"
display_name = "Бейте ещё"
description = "Байда провоцирует врагов на размен. До следующего хода каждое отдельное вражеское действие, повредившее его здоровью или обороне, восстанавливает 2 выносливости, но снижает броню на 1, вплоть до 3 раз."
branch = 3
stamina_cost = 4
cooldown_turns = 3
targeting = SubResource("Resource_targeting")
effects = Array[ExtResource("3_effect")]([SubResource("Resource_apply_stance")])