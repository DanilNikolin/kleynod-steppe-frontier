[resource]
script = ExtResource("1_ability")
ability_id = &"ability_bayda_without_looking_back"
display_name = "Без оглядки"
description = "Байда вкладывается в один безрассудный удар, пробивая броню и гарантируя высокий урон ценой собственной защиты."
branch = 2
growth_table = SubResource("Resource_growth_table")
stamina_cost = 9
initial_lock_turns = 2
cooldown_turns = 4
targeting = SubResource("Resource_targeting")
effects = Array[ExtResource("3_effect")]([SubResource("Resource_damage"), SubResource("Resource_bleeding"), SubResource("Resource_self_exposure")])